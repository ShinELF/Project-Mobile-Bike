{% extends "base.twig" %}

{% block content %}

<script src="../../js/addForm.js" defer ></script>

	<h2>{{ title }}</h2>
	<form method="post" action="/administration/add" class="container py-4">
		<div class="row">
			<div class="col-md-6">
				<div class="form-floating mb-3">
					<label for="image">Image</label>
					<input type="file" class="form-control" id="image" name="image" placeholder="Ajouter une image" required>
                    <div class="imagePreview"></div>
				</div>

				<div class="form-floating mb-3">
					<label for="modele">Modèle</label>
					<input type="text" class="form-control" id="modele" name="modele" required>
				</div>

				<div class="form-floating mb-3">
					<label for="price">Prix</label>
					<input type="text" class="form-control" id="price" name="price" required>
				</div>

				<div class="form-floating mb-3">
					<label for="description">Description</label>
					<input type="text" class="form-control" id="description" name="description">
				</div>

				
					<button type="submit" class="buttonForm">Créer un produit</button>
				
			</div>
		</div>
	</form>


{% endblock %}
