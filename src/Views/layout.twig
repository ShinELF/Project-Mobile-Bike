						</svg>
					</button>
					<ul class="sous-menu">
						<li>
							<a href="/compte">Mes&nbsp;informations</a>
						</li>
						<li>
							<a href="">Mes&nbsp;commandes</a>
						</li>
						<li>
							<form action="/logout-post" method="post" id="logout">
								<input type="hidden" name="action" value="logout">
							</form>
							<button class="user" type="submit" form="logout">
								<p id="logout-text">Déconnexion</p>
							</button>
						</li>
					</ul>
				{% endif %}
			</li>
		</ul>
		{{block("content", "user/login.twig")}}
	</header>
{% endblock %}

