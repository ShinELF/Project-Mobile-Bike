{% extends "base.twig" %}

{% block content %}
	<section class="login">

		<h1>{{ title }}</h1>

		<form method="post" action="/login-post">
			<div id="inputForm">
				<label id="loginLabel" for="login">Login</label>
				<input type="text" id="login" name="login" required>
			</div>

			<div id="inputForm">
				<label for="password" id="passwordLabel">Votre mot de passe</label>
				<input type="password" id="password" name="password" required>
			</div>

			<div>
				<h3>Pas encore inscrit ? <a href="/inscription">créez vôtre compte ici</a></h3>
			</div>

			<div id="inputForm">
				<button type="submit" id="btnForm">Connexion</button>
			</div>
		</form>

	</section>
{% endblock %}
