{% extends "base.twig" %}

{% block content %}
	<section class="login">

		<form method="post" action="/login-post">

			<h1 class="formTitle">{{ title }}</h1>

			<div class="inputArea">
				<label id="loginLabel" for="login">Login</label>
				<input type="text" id="login" name="login" required>

				<label for="password" id="passwordLabel">Mot de passe</label>
				<input type="password" id="password" name="password" required>
			</div>

			<button type="submit" class="buttonForm">Connexion</button>

			<div class="formParagraph">
				<p>Vous n'avez pas encore de compte ?
					<a href="/inscription">Créez un compte</a>
				</p>
			</div>

		</form>

	</section>
{% endblock %}
