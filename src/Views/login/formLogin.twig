{% extends "base.twig" %}

{% block content %}
	<section class="login">

		<h2>{{ title }}</h2>

		<form method="post" action="/login-post">
			<div id="inputForm">
				<label id="loginLabel" for="login">Votre login</label>
				<input type="text" id="login" name="login" required>
			</div>

			<div id="inputForm">
				<label for="password" id="passwordLabel">Votre mot de passe</label>
				<input type="password" id="password" name="password" required>
			</div>

			<div id="inputForm">
				<button type="submit" id="btnForm">Connexion</button>
			</div>
		</form>

	</section>
{% endblock %}
