<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ title }}</title>
		<link rel="stylesheet" href="/src/assets/css/main.css">

	</head>
	<body>
		<header>
			<nav>
				<ul>
					{% for link in links %}

						<li>
							<a href="{{ link.path }}" class="nav-link {% if link.active %} active{% endif %}">{{ link.title }}</a>
						</li>
					{% endfor %}
				</ul>
			</nav>
		</header>
		<div>
			{% block content %}{% endblock %}
		</div>
	</body>
</html>
