{% extends "base.twig" %}

{% block content %}
	<script src="/src/assets/js/administration.js" defer></script>
	<script src="/src/assets/js/addForm.js" defer></script>


	<section>
		<h2>Produits</h2>
		<button type="button" class="edit" commandfor="add-modale" command="show-modal">Ajout d'un produit
		</button>
		<section class="products">
			{% for prod in product %}
				<article class="product">
					<img src="/src/assets/img/shop/{{prod.image}}" alt="">
					<h3>
						{{prod.modele}}
					</h3>
					<p>
						A partir de
						{{prod.price}}
						€ (TVA compris)
					</p>
					<div class="buttons">
						<a href="/administration/edit/{{prod.id}}" class="edit">Modifier</a>
						<a href="/administration/delete/{{prod.id}}" class="delete">Supprimer</a>
					</div>
				</article>
			{% endfor %}
		</section>

		<dialog id="add-modale" closedby="any">
			<button type="button" commandfor="add-modale" command="close" class="close-button">Fermer</button>
			<form method="post" action="/administration/add">
				<div>
					<div>
						<div>
							<label for="image">Image</label>
							<input type="file" id="image" name="image" placeholder="Ajouter une image" required>
						</div>

						<div>
							<label for="modele">Modèle</label>
							<input type="text" id="modele" name="modele" required>
						</div>

						<div>
							<label for="price">Prix</label>
							<input type="text" id="price" name="price" required>
						</div>

						<div>
							<label for="description">Description</label>
							<input type="text" id="description" name="description">
						</div>

						<button type="submit">Créer un produit</button>

					</div>
				</div>
			</form>
		</dialog>
	</section>


{% endblock %}
