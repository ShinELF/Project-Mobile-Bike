{% extends "base.twig" %}

{% block content %}


	<h2>{{ title }}</h2>

	<h3>
		<a href="/users/add">Ajouter un utilisateur</a>
	</h3>
	<div >
		{# {% for user in users %} #}

			<div>
				<div>
					<div>
						<div>
							<h3>{{ user.login}}</h3>
							<a href="/users/update/{{user.id}}">Modifier</a>

							<a href="/users/delete/{{user.id}}">Supprimer</a>

						</div>
						<ul>
							<li>
								<span>ID :</span>
								{{ user.id }}</li>

							<li>
								<span>Password :</span>
								{{ user.password}}</li>

							<li>
								<span>Email :</span>
								{{ user.email}}</li>


						</ul>
					</div>
				</div>
			</div>
		{# {% endfor %} #}
	</div>
{% endblock %}
